# Copier ce fichier en .env puis changer les valeurs
POSTGRES_PASSWORD=change-moi
# Longue chaine aleatoire (ex. : openssl rand -hex 32)
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
# true uniquement derriere HTTPS (hebergement)
COOKIE_SECURE=false

# Communaute : pseudos des moderateurs (peuvent supprimer tous les messages)
ADMIN_USERS=
# Mots interdits supplementaires, separes par des virgules
BANNED_WORDS=

# Support : envoi des mails vers SUPPORT_TO
# Avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton adresse Gmail,
# SMTP_PASS=un "mot de passe d'application" (compte Google > Securite > Validation en 2 etapes > Mots de passe des applications)
# Adresse qui recoit les demandes (jamais affichee aux joueurs). Vide = demandes lisibles seulement dans la page Admin.
SUPPORT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Mise en ligne : informations legales affichees dans le site (pied de page) ----
# Adresse publique du site
SITE_URL=
# Editeur : laisser vide pour rester anonyme (particulier non professionnel, identite communiquee a l'hebergeur)
LEGAL_EDITOR=
# Hebergeur (obligatoire) : nom, adresse, telephone. Ex. : OVH SAS, 2 rue Kellermann 59100 Roubaix, 1007
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
# Depot public du code source (obligatoire : licence GPL-3.0), ex. https://github.com/ton-pseudo/bettermove
SOURCE_URL=

# Evenement de lancement (30 jours, parrainage) : date de debut. Vide = date du premier demarrage du serveur.
# A regler sur le jour de la sortie publique, ex. LAUNCH_EVENT_START=2026-12-01T00:00:00+01:00
LAUNCH_EVENT_START=

# Proxys devant l API : 1 (nginx seul) ou 2 (nginx + Caddy/Cloudflare)
TRUST_PROXY=1
